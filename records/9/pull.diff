+.sync-event.failed {
+  --event-color: var(--state-danger-fg);
+}
+
+.sync-event:not(:last-child)::after {
+  position: absolute;
+  top: 18px;
+  bottom: -4px;
+  left: 97px;
+  width: 1px;
+  background: var(--border);
+  content: '';
+}
+
+.sync-event-time {
+  padding-top: 12px;
+  color: var(--fg-dim);
+  font-family: var(--font-code);
+  font-size: 10.5px;
+  font-variant-numeric: tabular-nums;
+  text-align: right;
+  white-space: nowrap;
+}
+
+.sync-event-marker {
+  position: relative;
+  z-index: 1;
+  width: 9px;
+  height: 9px;
+  margin: 14px auto 0;
+  border: 2px solid var(--event-color);
+  border-radius: 50%;
+  background: var(--bg);
+  box-shadow: 0 0 0 3px var(--bg);
+}
+
+.sync-event.started .sync-event-marker {
+  background: var(--event-color);
+  animation: sync-pulse 1.5s ease-in-out infinite;
+}
+
+.sync-event-card {
+  min-width: 0;
+  padding: 12px 14px;
+  border: 1px solid var(--border);
+  border-radius: 7px;
+  background: color-mix(in srgb, var(--surface) 82%, transparent);
+}
+
+.sync-event.failed .sync-event-card {
+  border-color: color-mix(in srgb, var(--state-danger-fg) 42%, var(--border));
+  background: color-mix(in srgb, var(--state-danger-bg) 44%, var(--surface));
+}
+
+.sync-event-stage {
+  display: flex;
+  align-items: baseline;
+  min-width: 0;
+  gap: 8px;
+}
+
+.sync-event-stage strong {
+  overflow: hidden;
+  color: var(--fg);
+  font-size: 12.5px;
+  font-weight: 600;
+  text-overflow: ellipsis;
+  text-transform: capitalize;
+  white-space: nowrap;
+}
+
+.sync-event-seq {
+  color: var(--fg-dimmest);
+  font-family: var(--font-code);
+  font-size: 9.5px;
+  font-variant-numeric: tabular-nums;
+}
+
+.sync-event-state {
+  --sync-accent: var(--event-color);
+  --sync-tint: color-mix(in srgb, var(--event-color) 10%, transparent);
+  padding: 5px 7px;
+  font-size: 9px;
+}
+
+.sync-event-card > p {
+  margin: 7px 0 0;
+  color: var(--fg-muted);
+  font-size: 12px;
+  line-height: 1.5;
+}
+
+.sync-event-meta {
+  justify-content: flex-start;
+  flex-wrap: wrap;
+  margin-top: 9px;
+  color: var(--fg-dim);
+  font-family: var(--font-code);
+  font-size: 9.5px;
+  font-variant-numeric: tabular-nums;
+}
+
+.sync-event-duration {
+  color: var(--event-color);
+  font-weight: 650;
+}
+
+.sync-event-counts {
+  display: inline-flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.sync-event-counts strong {
+  color: var(--fg-secondary);
+  font-weight: 600;
+}
+
+.sync-log-empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  min-height: 220px;
+  padding: 28px;
+  border: 1px dashed var(--border-strong);
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--surface) 56%, transparent);
+  color: var(--fg-muted);
+  text-align: center;
+}
+
+.sync-log-title-row + .sync-log-empty {
+  margin-top: 16px;
+}
+
+.sync-log-empty.compact {
+  min-height: 120px;
+}
+
+.sync-log-empty-mark {
+  width: 11px;
+  height: 11px;
+  margin-bottom: 12px;
+  border: 2px solid var(--state-busy-fg);
+  border-radius: 50%;
+  box-shadow: 0 0 0 5px color-mix(in srgb, var(--state-busy-fg) 10%, transparent);
+}
+
+.sync-log-empty strong {
+  color: var(--fg-secondary);
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.sync-log-empty p {
+  max-width: 510px;
+  margin: 7px 0 0;
+  color: var(--fg-dim);
+  font-size: 12px;
+  line-height: 1.55;
+}
+
+@keyframes sync-pulse {
+  0%, 100% { opacity: 1; transform: scale(1); }
+  50% { opacity: 0.45; transform: scale(0.82); }
+}
+
+@media (max-width: 760px) {
+  .sync-log-summary {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .sync-event {
+    grid-template-columns: 66px 14px minmax(0, 1fr);
+    gap: 9px;
+  }
+
+  .sync-event:not(:last-child)::after {
+    left: 81.5px;
+  }
+}
+
+@media (max-width: 560px) {
+  .sync-log-hero {
+    padding: 16px;
+  }
+
+  .sync-log-summary {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .sync-summary-item.sync-summary-wide {
+    grid-column: span 1;
+  }
+
+  .sync-event {
+    grid-template-columns: 12px minmax(0, 1fr);
+  }
+
+  .sync-event-time {
+    grid-column: 2;
+    grid-row: 1;
+    padding: 0 0 3px;
+    text-align: left;
+  }
+
+  .sync-event-marker {
+    grid-column: 1;
+    grid-row: 2;
+    margin-top: 15px;
+  }
+
+  .sync-event-card {
+    grid-column: 2;
+    grid-row: 2;
+  }
+
+  .sync-event:not(:last-child)::after {
+    top: 37px;
+    left: 5.5px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .sync-overall-state.running::before,
+  .sync-event.started .sync-event-marker {
+    animation: none;
+  }
+}
