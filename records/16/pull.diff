+        assert_eq!(model.control(KeyCode::Char(' ')), Some(Command::Play {}));
+        model.pending = Some((2, Instant::now()));
+        assert!(!model.ready());
+        assert_eq!(model.status["playback"]["paused"], true);
+        model.disconnect("network lost".into());
+        assert!(!model.ready());
+    }
