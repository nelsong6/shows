diff --git a/desktop-rs/remote/src/main.rs b/desktop-rs/remote/src/main.rs
new file mode 100644
index 0000000..5998d81
--- /dev/null
+++ b/desktop-rs/remote/src/main.rs
@@ -0,0 +1,189 @@
+#![forbid(unsafe_code)]
+
+mod agent;
+mod ui;
+
+use clap::{Parser, Subcommand, ValueEnum};
+use serde_json::Value;
+use shows_control::{Command, resolve_show};
+use shows_remote::transport;
+use std::io::IsTerminal;
+use transport::Session;
+
+#[derive(Clone, Copy, ValueEnum)]
+enum Channel {
+    Stable,
+    Dev,
+}
+
+#[derive(Parser)]
+#[command(
+    version = version(),
+    about = "Control a running Shows desktop over your existing SSH connection.",
+    after_help = "Examples:\n  shows-remote upstairspc\n  shows-remote upstairspc play\n  shows-remote upstairspc play \"The Simpsons\"\n  shows-remote upstairspc status --json\n\nNo command opens the interactive remote. The target must already have Shows open."
+)]
+struct Args {
+    #[arg(default_value = "upstairspc")]
+    target: String,
+    #[arg(long, value_enum, default_value = "stable", global = true)]
+    channel: Channel,
+    #[arg(
+        long,
+        global = true,
+        help = "Print the result as JSON (requires a command)"
+    )]
+    json: bool,
+    #[arg(long, hide = true)]
+    agent: bool,
+    #[arg(long, help = "Control Shows on this PC without SSH")]
+    local: bool,
+    #[command(subcommand)]
+    command: Option<Action>,
+}
+
+fn version() -> String {
+    format!(
+        "{} ({})",
+        env!("CARGO_PKG_VERSION"),
+        option_env!("SHOWS_BUILD_SHA").unwrap_or("source")
+    )
+}
+
+#[derive(Subcommand)]
+enum Action {
+    /// Show the target's current playback state.
+    Status,
+    /// List the target's current round and show IDs.
+    Queue,
+    /// Resume playback, or navigate to a show in the current round.
+    Play { show: Option<String> },
+    /// Pause playback (safe to repeat).
+    Pause,
+    /// Mark the current episode watched and move forward.
+    Skip,
+    /// Navigate back without marking watched.
+    Previous,
+    /// Move this episode to the back of its show's queue without marking watched.
+    Defer,
+    /// Seek by a relative number of seconds.
+    Seek {
+        #[arg(allow_hyphen_values = true)]
+        seconds: f64,
+    },
+    /// Set volume from 0 to 130.
+    Volume { level: f64 },
+}
+
+fn run() -> Result<(), String> {
+    let args = Args::parse();
+    if args.agent {
+        return agent::run();
+    }
+    if args.command.is_none()
+        && (args.json || !std::io::stdin().is_terminal() || !std::io::stdout().is_terminal())
+    {
+        return Err("The interactive remote needs a terminal. Use a command such as status --json for scripts.".into());
+    }
+    let channel = match args.channel {
+        Channel::Stable => "stable",
+        Channel::Dev => "dev",
+    };
+    let mut session = Session::connect(&args.target, channel, args.local)?;
+    let Some(action) = args.command else {
+        return ui::run(session, &args.target, channel, args.local);
+    };
+    let command = match action {
+        Action::Status => Command::Status {},
+        Action::Queue => Command::Queue {},
+        Action::Play { show: Some(query) } => Command::PlayShow {
+            show_id: resolve_show(&session.call(Command::Status {})?, &query)?,
+        },
+        Action::Play { show: None } => Command::Play {},
+        Action::Pause => Command::Pause {},
+        Action::Skip => Command::Skip {},
+        Action::Previous => Command::Previous {},
+        Action::Defer => Command::Defer {},
+        Action::Seek { seconds } => Command::Seek { seconds },
+        Action::Volume { level } => Command::Volume { level },
+    };
+    command.validate()?;
+    let result = session.call(command.clone())?;
+    if args.json {
+        println!(
+            "{}",
+            serde_json::to_string_pretty(&result).map_err(|e| e.to_string())?
+        );
+    } else {
+        println!(
+            "{}",
+            if args.local {
+                "Local Shows"
+            } else {
+                &args.target
+            }
+        );
+        match command {
+            Command::Status {} => print_status(&result),
+            Command::Queue {} => {
+                if let Some(round) = result.as_array() {
+                    for (i, entry) in round.iter().enumerate() {
+                        println!(
+                            "{:>2}. {}  [{}]",
+                            i + 1,
+                            text(&entry["show_name"]),
+                            text(&entry["show_id"])
+                        );
+                    }
+                }
+            }
+            _ => println!("{}", text(&result["message"])),
+        }
+    }
+    Ok(())
+}
+
+pub fn text(value: &Value) -> &str {
+    value.as_str().unwrap_or("—")
+}
+
+pub fn current(status: &Value) -> &Value {
+    let pos = status["round_pos"].as_u64().unwrap_or(0) as usize;
+    &status["round"][pos]
+}
+
+pub fn clock(value: &Value) -> String {
+    let seconds = value
+        .as_f64()
+        .filter(|v| v.is_finite() && *v >= 0.0)
+        .unwrap_or(0.0) as u64;
+    format!("{}:{:02}", seconds / 60, seconds % 60)
+}
+
+fn print_status(status: &Value) {
+    let playback = &status["playback"];
+    println!("{} — {}", text(&status["phase"]), text(&status["message"]));
+    println!(
+        "{} | {} / {} | {} | volume {}",
+        text(&current(status)["show_name"]),
+        clock(&playback["time_pos"]),
+        clock(&playback["duration"]),
+        if playback["paused"] == true {
+            "paused"
+        } else {
+            "playing"
+        },
+        playback["volume"]
+    );
+    if let Some(alerts) = status["alerts"].as_array() {
+        for alert in alerts {
+            println!("{}", text(&alert["message"]));
+        }
+    }
+}
+
+fn main() {
+    if let Err(message) = run() {
+        eprintln!("shows-remote: {message}");
+        std::process::exit(1);
+    }
+}
diff --git a/desktop-rs/remote/src/transport.rs b/desktop-rs/remote/src/transport.rs
new file mode 100644
index 0000000..1e6e14d
--- /dev/null
+++ b/desktop-rs/remote/src/transport.rs
@@ -0,0 +1,164 @@
+use std::io::{BufReader, Write};
+use std::process::{Child, ChildStdin, Command as ProcessCommand, Stdio};
+use std::sync::mpsc::{self, Receiver};
+use std::time::{Duration, Instant};
+
+use serde_json::Value;
+use shows_control::{Command, Frame, Request, read_line};
+
+pub const REQUEST_TIMEOUT: Duration = Duration::from_secs(12);
+
+pub fn valid_host(host: &str) -> bool {
+    !host.is_empty()
+        && host.len() <= 253
+        && host.as_bytes()[0].is_ascii_alphanumeric()
+        && host
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || c == b'-' || c == b'.')
+}
+
+pub fn remote_command(channel: &str) -> String {
+    assert!(matches!(channel, "stable" | "dev"));
+    // The verified installer writes this one-line native entry point. Neither
+    // JSON commands nor show names enter the remote command line.
+    format!(r#""%LOCALAPPDATA%\shows\agents\{channel}.cmd""#)
+}
+
+pub struct Session {
+    child: Child,
+    input: ChildStdin,
+    pub events: Receiver<Frame>,
+    next_id: u64,
+}
+
+impl Session {
+    pub fn connect(host: &str, channel: &str, local: bool) -> Result<Self, String> {
+        if !valid_host(host) {
+            return Err("target must be a computer hostname or SSH host alias".into());
+        }
+        let mut command = if local {
+            let mut cmd = ProcessCommand::new(std::env::current_exe().map_err(|e| e.to_string())?);
+            cmd.arg("--agent");
+            cmd
+        } else {
+            let mut cmd = ProcessCommand::new("ssh.exe");
+            cmd.args([
+                "-T",
+                "-o",
+                "BatchMode=yes",
+                "-o",
+                "StrictHostKeyChecking=yes",
+                "-o",
+                "ConnectTimeout=8",
+                "-o",
+                "ServerAliveInterval=5",
+                "-o",
+                "ServerAliveCountMax=2",
+                host,
+                &remote_command(channel),
+            ]);
+            cmd
+        };
+        let mut child = command
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .map_err(|e| {
+                format!(
+                    "could not start {}: {e}",
+                    if local {
+                        "local agent"
+                    } else {
+                        "Windows OpenSSH"
+                    }
+                )
+            })?;
+        let input = child.stdin.take().unwrap();
+        let output = child.stdout.take().unwrap();
+        let errors = child.stderr.take().unwrap();
+        let (tx, events) = mpsc::sync_channel(32);
+        let diagnostics = std::sync::Arc::new(std::sync::Mutex::new(String::new()));
+        let capture = diagnostics.clone();
+        std::thread::spawn(move || {
+            let mut reader = BufReader::new(errors);
+            while let Ok(Some(line)) = read_line(&mut reader) {
+                let mut text = capture.lock().unwrap();
+                if text.len() < 8192 {
+                    text.push_str(&line);
+                }
+            }
+        });
+        std::thread::spawn(move || {
+            let mut reader = BufReader::new(output);
+            let result = loop {
+                match read_line(&mut reader) {
+                    Ok(Some(line)) => match serde_json::from_str(&line) {
+                        Ok(frame) => {
+                            if tx.send(frame).is_err() {
+                                return;
+                            }
+                        }
+                        Err(e) => break format!("invalid remote protocol message: {e}"),
+                    },
+                    Ok(None) => break "remote connection closed".to_string(),
+                    Err(e) => break e,
+                }
+            };
+            // stderr may finish just after stdout; give its reader a bounded chance.
+            std::thread::sleep(Duration::from_millis(50));
+            let details = diagnostics.lock().unwrap().trim().to_string();
+            let message = if details.is_empty() {
+                result
+            } else {
+                format!("{result}: {details}")
+            };
+            let _ = tx.send(Frame::Disconnected { message });
+        });
+        Ok(Self {
+            child,
+            input,
+            events,
+            next_id: 0,
+        })
+    }
+
+    pub fn send(&mut self, command: Command) -> Result<u64, String> {
+        command.validate()?;
+        self.next_id += 1;
+        let request = Request {
+            id: self.next_id,
+            command,
+        };
+        serde_json::to_writer(&mut self.input, &request).map_err(|e| e.to_string())?;
+        self.input
+            .write_all(b"\n")
+            .and_then(|_| self.input.flush())
+            .map_err(|e| e.to_string())?;
+        Ok(request.id)
+    }
+
+    pub fn call(&mut self, command: Command) -> Result<Value, String> {
+        let id = self.send(command)?;
+        let deadline = Instant::now() + REQUEST_TIMEOUT;
+        loop {
+            let event = self.events.recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                .map_err(|_| "Remote response timed out. The outcome may be unknown; check status before retrying.".to_string())?;
+            match event {
+                Frame::Reply {
+                    id: reply_id,
+                    result,
+                } if id == reply_id => return result,
+                Frame::Disconnected { message } => return Err(message),
+                _ => (),
+            }
+        }
+    }
+}
+
+impl Drop for Session {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
diff --git a/desktop-rs/remote/src/ui.rs b/desktop-rs/remote/src/ui.rs
new file mode 100644
index 0000000..854369d
--- /dev/null
+++ b/desktop-rs/remote/src/ui.rs
@@ -0,0 +1,355 @@
+use std::time::{Duration, Instant};
+
+use crossterm::event::{self, Event, KeyCode, KeyEventKind, KeyModifiers};
+use ratatui::{
+    Frame as TerminalFrame,
+    layout::{Constraint, Layout},
+    style::{Color, Modifier, Style},
+    widgets::{Block, Gauge, List, ListItem, ListState, Paragraph, Wrap},
+};
+use serde_json::Value;
+use shows_control::{Command, Frame};
+
+use crate::{
+    clock, current, text,
+    transport::{REQUEST_TIMEOUT, Session},
+};
+
+struct Model {
+    status: Value,
+    connected: bool,
+    selected: usize,
+    notice: String,
+    pending: Option<(u64, Instant)>,
+}
+
+impl Model {
+    fn connecting(id: u64) -> Self {
+        Self {
+            status: Value::Null,
+            connected: false,
+            selected: 0,
+            notice: "Connecting to the running Shows instance…".into(),
+            pending: Some((id, Instant::now())),
+        }
+    }
+
+    fn disconnect(&mut self, message: String) {
+        self.connected = false;
+        self.pending = None;
+        self.notice =
+            format!("Disconnected: {message}  Press r to reconnect; commands are never replayed.");
+    }
+
+    fn receive(&mut self, frame: Frame) {
+        match frame {
+            Frame::Status { status } => {
+                if self.status.is_null() {
+                    self.selected = status["round_pos"].as_u64().unwrap_or(0) as usize;
+                    self.notice = "Connected. Controls affect only the target PC.".into();
+                }
+                self.connected = true;
+                self.status = status;
+                self.selected = self.selected.min(self.round_len().saturating_sub(1));
+            }
+            Frame::Reply { id, result } if self.pending.is_some_and(|p| p.0 == id) => {
+                self.pending = None;
+                self.notice = match result {
+                    Ok(result) => result["message"]
+                        .as_str()
+                        .unwrap_or("Target accepted the request")
+                        .to_string(),
+                    Err(error) => format!("Request failed: {error}"),
+                };
+            }
+            Frame::Disconnected { message } => self.disconnect(message),
+            _ => (),
+        }
+    }
+
+    fn round_len(&self) -> usize {
+        self.status["round"].as_array().map_or(0, Vec::len)
+    }
+
+    fn ready(&self) -> bool {
+        self.connected && self.pending.is_none() && shows_control::playback_ready(&self.status)
+    }
+
+    fn control(&self, key: KeyCode) -> Option<Command> {
+        let playback = &self.status["playback"];
+        match key {
+            KeyCode::Char(' ') => Some(if playback["paused"] == true {
+                Command::Play {}
+            } else {
+                Command::Pause {}
+            }),
+            KeyCode::Char('s') => Some(Command::Play {}),
+            KeyCode::Char('p') => Some(Command::Pause {}),
+            KeyCode::Char('n') => Some(Command::Skip {}),
+            KeyCode::Char('b') => Some(Command::Previous {}),
+            KeyCode::Char('d') => Some(Command::Defer {}),
+            KeyCode::Left => Some(Command::Seek { seconds: -10.0 }),
+            KeyCode::Right => Some(Command::Seek { seconds: 10.0 }),
+            KeyCode::Char('+') | KeyCode::Char('=') => Some(Command::Volume {
+                level: (playback["volume"].as_f64()? + 5.0).clamp(0.0, 130.0),
+            }),
+            KeyCode::Char('-') => Some(Command::Volume {
+                level: (playback["volume"].as_f64()? - 5.0).clamp(0.0, 130.0),
+            }),
+            KeyCode::Enter => Some(Command::PlayShow {
+                show_id: self.status["round"][self.selected]["show_id"]
+                    .as_str()?
+                    .to_string(),
+            }),
+            _ => None,
+        }
+    }
+}
+
+fn draw(frame: &mut TerminalFrame, model: &Model, target: &str) {
+    let areas = Layout::vertical([
+        Constraint::Length(4),
+        Constraint::Length(3),
+        Constraint::Min(3),
+        Constraint::Length(4),
+        Constraint::Length(3),
+    ])
+    .split(frame.area());
+    let playback = &model.status["playback"];
+    let state = if !model.connected {
+        "DISCONNECTED"
+    } else if playback["paused"] == true {
+        "PAUSED"
+    } else {
+        text(&model.status["phase"])
+    };
+    let color = if model.connected {
+        Color::Cyan
+    } else {
+        Color::Yellow
+    };
+    let headline = format!(
+        "{}  |  {} / {}  |  volume {}\n{}",
+        text(&current(&model.status)["show_name"]),
+        clock(&playback["time_pos"]),
+        clock(&playback["duration"]),
+        playback["volume"]
+            .as_f64()
+            .map_or("—".into(), |v| format!("{v:.0}")),
+        text(&model.status["message"])
+    );
+    frame.render_widget(
+        Paragraph::new(headline)
+            .block(
+                Block::bordered()
+                    .title(format!(" Shows Remote → {target}  ·  {state} "))
+                    .border_style(Style::default().fg(color)),
+            )
+            .wrap(Wrap { trim: true }),
+        areas[0],
+    );
+    let percent = playback["percent_pos"]
+        .as_f64()
+        .filter(|v| v.is_finite())
+        .unwrap_or(0.0)
+        .clamp(0.0, 100.0);
+    frame.render_widget(
+        Gauge::default()
+            .block(Block::bordered().title(" Playback "))
+            .ratio(percent / 100.0)
+            .gauge_style(Style::default().fg(color)),
+        areas[1],
+    );
+    let pos = model.status["round_pos"].as_u64().unwrap_or(0) as usize;
+    let items: Vec<ListItem> = model.status["round"]
+        .as_array()
+        .map(|round| {
+            round
+                .iter()
+                .enumerate()
+                .map(|(i, entry)| {
+                    ListItem::new(format!(
+                        "{} {:>2}. {}",
+                        if i == pos { ">" } else { " " },
+                        i + 1,
+                        text(&entry["show_name"])
+                    ))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let list = List::new(items)
+        .block(Block::bordered().title(" Target's current round · ↑↓ select · Enter play "))
+        .highlight_style(Style::default().add_modifier(Modifier::REVERSED));
+    let mut selection = ListState::default().with_selected(if model.round_len() > 0 {
+        Some(model.selected)
+    } else {
+        None
+    });
+    frame.render_stateful_widget(list, areas[2], &mut selection);
+    let alerts = model.status["alerts"]
+        .as_array()
+        .map(|alerts| {
+            alerts
+                .iter()
+                .filter_map(|a| a["message"].as_str())
+                .collect::<Vec<_>>()
+                .join(" | ")
+        })
+        .unwrap_or_default();
+    let notice = format!(
+        "{}{}{}",
+        if model.pending.is_some() {
+            "Waiting for target… "
+        } else {
+            ""
+        },
+        model.notice,
+        if alerts.is_empty() {
+            String::new()
+        } else {
+            format!("\n{alerts}")
+        }
+    );
+    frame.render_widget(
+        Paragraph::new(notice)
+            .block(Block::bordered().title(" Connection / result "))
+            .wrap(Wrap { trim: true })
+            .style(Style::default().fg(color)),
+        areas[3],
+    );
+    frame.render_widget(Paragraph::new("Space play/pause · s play · p pause · n skip (marks watched) · b previous\nd defer · ←→ seek 10s · +/- volume · r reconnect · q quit")
+        .wrap(Wrap { trim: true }), areas[4]);
+}
+
+pub fn run(mut session: Session, target: &str, channel: &str, local: bool) -> Result<(), String> {
+    let id = session.send(Command::Watch {})?;
+    let mut model = Model::connecting(id);
+    let mut connection = Some(session);
+    let mut started = Instant::now();
+    let mut last_activity = Instant::now();
+    let mut terminal = ratatui::try_init().map_err(|e| e.to_string())?;
+    let result = (|| {
+        loop {
+            let mut lost = false;
+            if let Some(session) = connection.as_ref() {
+                while let Ok(frame) = session.events.try_recv() {
+                    last_activity = Instant::now();
+                    lost |= matches!(&frame, Frame::Disconnected { .. });
+                    model.receive(frame);
+                }
+            }
+            if lost {
+                connection.take();
+            }
+            if model.connected && last_activity.elapsed() > Duration::from_secs(65) {
+                model.disconnect("No status or heartbeat from Shows for 65 seconds".into());
+                connection.take();
+            }
+            if model
+                .pending
+                .is_some_and(|p| p.1.elapsed() > REQUEST_TIMEOUT)
+                || (!model.connected && connection.is_some() && started.elapsed() > REQUEST_TIMEOUT)
+            {
+                model.disconnect("Response timed out. A sent command's outcome may be unknown; inspect status before retrying.".into());
+                connection.take();
+            }
+            terminal
+                .draw(|frame| draw(frame, &model, if local { "this PC" } else { target }))
+                .map_err(|e| e.to_string())?;
+            if !event::poll(Duration::from_millis(100)).map_err(|e| e.to_string())? {
+                continue;
+            }
+            let Event::Key(key) = event::read().map_err(|e| e.to_string())? else {
+                continue;
+            };
+            if key.kind != KeyEventKind::Press {
+                continue;
+            }
+            if matches!(key.code, KeyCode::Char('q') | KeyCode::Esc)
+                || (key.code == KeyCode::Char('c') && key.modifiers.contains(KeyModifiers::CONTROL))
+            {
+                return Ok(());
+            }
+            match key.code {
+                KeyCode::Down => {
+                    model.selected = (model.selected + 1).min(model.round_len().saturating_sub(1))
+                }
+                KeyCode::Up => model.selected = model.selected.saturating_sub(1),
+                KeyCode::Char('r') if !model.connected => {
+                    connection.take();
+                    match Session::connect(target, channel, local)
+                        .and_then(|mut s| s.send(Command::Watch {}).map(|id| (s, id)))
+                    {
+                        Ok((session, id)) => {
+                            connection = Some(session);
+                            model = Model::connecting(id);
+                            started = Instant::now();
+                            last_activity = Instant::now();
+                        }
+                        Err(message) => model.disconnect(message),
+                    }
+                }
+                _ if model.ready() => {
+                    if let Some(command) = model.control(key.code) {
+                        match connection
+                            .as_mut()
+                            .ok_or("connection unavailable")
+                            .and_then(|s| {
+                                s.send(command)
+                                    .map_err(|_| "could not send control; reconnect")
+                            }) {
+                            Ok(id) => model.pending = Some((id, Instant::now())),
+                            Err(error) => model.disconnect(error.into()),
+                        }
+                    }
+                }
+                _ => (),
+            }
+        }
+    })();
+    ratatui::restore();
+    result
